gen_store(t,x){prev=peek(t,0,0);poke(t,x,0,0);return prev,peek(t,0,0);}gen_delay(d,x){prev=d.read(2);d.write(x);return prev;}gen_pass(t,d,x){old,now=gen_store(t,x);echoed=gen_delay(d,x);return old,now,echoed;}Data first(4);Data second(4);Delay firstDelay(8);Delay secondDelay(8);oldA,nowA,echoA=gen_pass(first,firstDelay,in1);oldB,nowB,echoB=gen_pass(second,secondDelay,in2);out1=oldA;out2=nowA;out3=echoA;out4=oldB;out5=nowB;out6=echoB;out7=peek(first,0,0);out8=peek(second,0,0);